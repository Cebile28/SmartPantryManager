<?xml version="1.0" encoding="utf-8"?>
<!--
    The pantry list screen.

    A RelativeLayout lets the empty-state message sit centred on top of the
    same area the RecyclerView occupies: exactly one of the two is visible at
    any time, decided in code by showEmptyState().
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#00796B"
        android:elevation="4dp"
        app:titleTextColor="#FFFFFF" />

    <!-- Shown only when expiry alerts are switched on in Settings and
         something is actually expiring within the chosen window -->
    <TextView
        android:id="@+id/textExpiryBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:padding="12dp"
        android:background="#FFF3E0"
        android:textColor="#E65100"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPantry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/textExpiryBanner"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="vertical" />

    <!-- Shown instead of the list when the pantry is empty -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/textExpiryBanner"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your pantry is empty"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#616161" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap + to add the ingredients you have at home"
            android:textSize="15sp"
            android:textColor="#9E9E9E"
            android:gravity="center" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add pantry item"
        app:backgroundTint="#00796B"
        app:tint="#FFFFFF" />

</RelativeLayout>