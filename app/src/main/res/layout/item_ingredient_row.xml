<?xml version="1.0" encoding="utf-8"?>
<!--
    One ingredient line on the recipe detail screen. Inflated in code once per
    ingredient, with a tick or a cross showing whether the user already has it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/textTick"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="OK" />

    <TextView
        android:id="@+id/textIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="#424242"
        tools:text="50 g Cheese" />

</LinearLayout>